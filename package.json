{
  "name": "lawlense-backend",
  "version": "1.0.0",
  "description": "LawLens - AI-Powered Legal Research Platform Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/runTests.js tests/ragTests.js",
    "sync-laws": "node legal-sync/index.js --sync",
    "validate-laws": "node legal-sync/index.js --validate",
    "rebuild-laws": "node legal-sync/index.js --rebuild",
    "audit-laws": "node legal-sync/index.js --audit",
    "postinstall": "node scripts/rebuildVector.js",
    "rebuild-vector": "node scripts/rebuildVector.js",
    "seed": "node scripts/seedData.js",
    "migrate": "node scripts/migrateToFirestore.js",
    "lkos": "node knowledge/cli.js",
    "lkos:sync": "node knowledge/cli.js --sync",
    "lkos:status": "node knowledge/cli.js --status",
    "lkos:benchmark": "node knowledge/cli.js --benchmark",
    "lkos:heal": "node knowledge/cli.js --heal",
    "lkos:graph": "node knowledge/cli.js --graph",
    "lkos:sources": "node knowledge/cli.js --sources",
    "lkos:report": "node knowledge/cli.js --report"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^12.0.0",
    "groq-sdk": "^0.8.0",
    "helmet": "^7.1.0",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.0",
    "zod": "^4.4.3"
  }
}
